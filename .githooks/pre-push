#!/usr/bin/env bash
# Aborts push if dart format modifies any Dart file in the commits being pushed.
# Skips generated files (*.g.dart, *.freezed.dart, *.mocks.dart).

ZERO_SHA="0000000000000000000000000000000000000000"
dart_files=()

while IFS=' ' read -r _local_ref local_sha _remote_ref remote_sha; do
  # Skip branch deletions.
  [[ "$local_sha" == "$ZERO_SHA" ]] && continue

  if [[ "$remote_sha" == "$ZERO_SHA" ]]; then
    # New branch — diff against the common ancestor with the remote default branch.
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null \
        || git merge-base "$local_sha" origin/HEAD 2>/dev/null \
        || echo "")
    [[ -z "$base" ]] && continue
    range="$base..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  while IFS= read -r file; do
    [[ -f "$file" ]] && dart_files+=("$file")
  done < <(
    git diff --name-only "$range" -- '*.dart' \
      | grep -Ev '\.(g|freezed|mocks)\.dart$' || true
  )
done

[[ ${#dart_files[@]} -eq 0 ]] && exit 0

dart format "${dart_files[@]}"

unformatted=$(git diff --name-only -- "${dart_files[@]}")
if [[ -n "$unformatted" ]]; then
  echo ""
  echo "[pre-push] dart format modified the following file(s):"
  while IFS= read -r f; do echo "  $f"; done <<< "$unformatted"
  echo ""
  echo "Stage and commit the formatted changes, then push again."
  echo ""
  exit 1
fi

exit 0
